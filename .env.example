# Copy to .env.local and fill in. Without RESEND_API_KEY, join applications
# and member login links are logged to the server console instead of emailed.

# API key from https://resend.com
RESEND_API_KEY=

# Where new membership applications get emailed
JOIN_NOTIFY_EMAIL=hello@example.org

# Must be a verified sending domain/address in Resend (used for both join
# notifications and member login links)
JOIN_FROM_EMAIL=applications@example.org

# Signs member-login and session tokens. Generate with: openssl rand -base64 32
# Keep this secret and stable — rotating it logs everyone out.
AUTH_SECRET=
