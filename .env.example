# Copy to .env.local and fill in to enable the "Join" form to actually send email.
# Without these, submissions are logged to the server console instead.

# API key from https://resend.com
RESEND_API_KEY=

# Where new membership applications get emailed
JOIN_NOTIFY_EMAIL=hello@example.org

# Must be a verified sending domain/address in Resend
JOIN_FROM_EMAIL=applications@example.org
