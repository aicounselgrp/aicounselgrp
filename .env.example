# Copy to .env.local and fill in. Without RESEND_API_KEY, join applications
# and login links are logged to the server console instead of emailed.

# Postgres connection string. For local dev, run:
#   docker run -d --name ai-legal-guild-db -e POSTGRES_PASSWORD=localdev \
#     -e POSTGRES_DB=ai_legal_guild -p 5433:5432 postgres:16-alpine
#   psql "$DATABASE_URL" -f db/schema.sql
# In production, use a hosted Postgres (e.g. Neon via the Vercel Marketplace).
DATABASE_URL=postgres://postgres:localdev@localhost:5433/ai_legal_guild

# Comma-separated emails allowed to log into /admin and approve/reject
# applications and deactivate members from the dashboard.
ADMIN_EMAILS=steph@example.org

# API key from https://resend.com
RESEND_API_KEY=

# Where new membership applications get emailed (can be a shared inbox —
# the one-click approve/reject links in that email don't require login)
JOIN_NOTIFY_EMAIL=hello@example.org

# Must be a verified sending domain/address in Resend (used for join
# notifications and login links)
JOIN_FROM_EMAIL=applications@example.org

# Signs login and session tokens. Generate with: openssl rand -base64 32
# Keep this secret and stable — rotating it logs everyone out.
AUTH_SECRET=
